# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Firebase Realtime Database URL, e.g. https://<project>-default-rtdb.<region>.firebasedatabase.app
DATABASE_URL=

# Firebase service-account key fields (from the downloaded service-account JSON)
TYPE=service_account
PROJECT_ID=
PRIVATE_KEY_ID=
# Single line, with newlines written as \n
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
TOKEN_URI=https://oauth2.googleapis.com/token

# Optional service-account fields
AUTH_URI=https://accounts.google.com/o/oauth2/auth
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=
UNIVERSE_DOMAIN=googleapis.com
